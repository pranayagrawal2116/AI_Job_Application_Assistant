{
  "manifest_version": 3,
  "name": "JobFlow AI — Employer Form Auto-Fill Companion",
  "version": "1.0.0",
  "description": "Auto-populates external employer application forms with verified candidate details under strict human-in-the-loop control.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobFlow AI Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:8000/*",
    "https://*.lever.co/*",
    "https://*.greenhouse.io/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.keka.com/*",
    "https://*.ripplehire.com/*",
    "https://*.kula.ai/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["jobflow_bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.keka.com/*",
        "https://*.ripplehire.com/*",
        "https://*.kula.ai/*"
      ],
      "exclude_matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
