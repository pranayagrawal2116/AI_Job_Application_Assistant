# =====================================================================
# AI Job Application Assistant - Production Environment Configuration
# Windows Server 2016 + IIS 10 Deployment
# Architecture: v2.1.1
# =====================================================================
# Instructions:
# 1. Copy this file to .env in your application directory (e.g. C:\Apps\AI_Job_Application_Assistant\.env).
# 2. Generate cryptographically strong 256-bit hex keys for each secret:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. DO NOT commit the .env file or real secrets to Git.
# =====================================================================

# 1. Application Environment & Logging
APP_ENV=production
LOG_LEVEL=INFO

# 2. Dedicated Production File Storage Paths (Outside IIS Web Root)
DATABASE_PATH=D:\AIJobAssistantData\database\job_assistant.db
USER_STORAGE_BASE=D:\AIJobAssistantData\users
BACKUP_DIR=D:\AIJobAssistantData\backups
EXPORTS_DIR=D:\AIJobAssistantData\exports

# 3. Session Management & Password Security (64-character Hex / 256-bit)
# Generate each using: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=generate_and_insert_64_character_hex_session_secret_key_0000000000
PASSWORD_RESET_PEPPER=generate_and_insert_64_character_hex_pwd_reset_pepper_0000000000
AUDIT_LOG_PEPPER=generate_and_insert_64_character_hex_audit_pepper_000000000000000000

# 4. Action Ticket HMAC Signing & Rotation Keys
ACTION_TICKET_ACTIVE_KEY_ID=prod_v1
ACTION_TICKET_SECRET_KEY=generate_and_insert_64_character_hex_action_ticket_key_0000000
ACTION_TICKET_ROTATION_KEYS={"prod_v1":"generate_and_insert_64_character_hex_action_ticket_key_0000000"}

# 5. Security Scan HMAC Verification Keys
SECURITY_SCAN_ACTIVE_KEY_ID=scan_prod_v1
SECURITY_SCAN_SIGNING_KEY=generate_and_insert_64_character_hex_scan_signing_key_0000000
SECURITY_SCAN_ROTATION_KEYS={"scan_prod_v1":"generate_and_insert_64_character_hex_scan_signing_key_0000000"}

# 6. Safety & Human-in-the-Loop Governance (STRICT: Always false in production)
ALLOW_AUTOMATED_SUBMISSION=false
RESPECT_ROBOTS_TXT=true
HEADLESS=true

# 7. Historical Legacy Evidence & Cryptographic Policy
# In production, asymmetric Ed25519 digital signatures are enforced.
# If no historical legacy migrations are present, leave arrays empty (fails closed safely).
LEGACY_EVIDENCE_POLICY=production
LEGACY_EVIDENCE_TRUSTED_KEYS={}
LEGACY_EVIDENCE_TRUSTED_ISSUERS=[]
LEGACY_EVIDENCE_TRUSTED_PRINCIPALS=[]
LEGACY_EVIDENCE_REVOKED_KEYS=[]
LEGACY_EVIDENCE_REVOKED_PRINCIPALS=[]
