<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 10 Reverse-Proxy Configuration for Streamlit
  Universal AI Job Application Assistant (Architecture v2.1.1)

  Prerequisites in IIS:
  1. Application Request Routing (ARR) 3.0 installed and Proxy enabled.
  2. URL Rewrite Module 2.1 installed.
  3. IIS WebSocket Protocol feature enabled (Server Manager -> Roles -> Web Server -> Application Development -> WebSocket Protocol).
-->
<configuration>
  <system.webServer>
    <!-- Request Size Ceiling (30 MB in bytes) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <!-- Rule 1: Proxy Streamlit WebSockets (_stcore/stream) -->
        <rule name="Streamlit WebSocket Proxy" stopProcessing="true">
          <match url="^_stcore/stream(.*)" />
          <conditions>
            <add input="{HTTP_UPGRADE}" pattern="websocket" ignoreCase="true" />
          </conditions>
          <action type="Rewrite" url="ws://127.0.0.1:8501/_stcore/stream{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!-- Rule 2: Proxy All Standard HTTP/HTTPS Traffic to Streamlit -->
        <rule name="Streamlit HTTP Reverse Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8501/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Essential Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
